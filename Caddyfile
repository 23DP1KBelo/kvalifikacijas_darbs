{
	frankenphp
}

:8080 {
	root * /app/dejotajs/public

	# Serve any request that maps to a real file on disk directly,
	# including Vite-built assets under /build/, images, fonts, etc.
	@static file
	handle @static {
		file_server
	}

	# Everything else goes to Laravel via FrankenPHP
	handle {
		php_server
	}
}

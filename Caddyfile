{
	frankenphp
}

:8080 {
	root * /app/dejotajs/public

	# Serve static files directly (Vite-built assets, images, fonts, etc.)
	@static {
		file
		path_regexp static ^/(build|public)/
	}
	handle @static {
		file_server
	}

	# Serve well-known root-level static files directly
	@rootstatic {
		file
		path /favicon.ico /robots.txt
	}
	handle @rootstatic {
		file_server
	}

	# Route all other requests through FrankenPHP to Laravel's front controller
	php_server
}

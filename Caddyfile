{
	frankenphp
}

:8080 {
	root * /app/dejotajs/public

	# Serve static files directly (Vite-built assets, images, fonts, etc.)
	@static {
		file
		path /build/assets/* /favicon.ico /robots.txt
	}
	handle @static {
		file_server
	}

	# Route all other requests through FrankenPHP to Laravel's front controller
	php_server
}
